@model WEB_UI.Models.DashboardViewModel

@{
    ViewData["Title"] = "Sistema de Gestión de Vehículos";
}

<style>
    /* ---------- Layout y espacios generales ---------- */

    .hero-section {
        border-radius: 1.5rem;
        padding: 2.5rem 2rem;
        background: linear-gradient(135deg, #f8f9ff, #fdfdfd);
        border: 1px solid #e5e7f1;
        box-shadow: 0 10px 30px rgba(15, 23, 42, 0.04);
        margin-bottom: 2.5rem;
    }

    .hero-section h1 {
        letter-spacing: -0.03em;
    }

    .hero-tag {
        font-size: 0.78rem;
        letter-spacing: 0.08em;
    }

    .card-soft {
        border-radius: 1.1rem;
        border: 1px solid #edf0f5;
        box-shadow: 0 8px 24px rgba(15, 23, 42, 0.04);
    }

    .card-hover {
        transition: transform 0.18s ease-out, box-shadow 0.18s ease-out, border-color 0.18s ease-out;
    }

    .card-hover:hover {
        transform: translateY(-4px);
        box-shadow: 0 16px 35px rgba(15, 23, 42, 0.08);
        border-color: #d0d7f2;
    }

    .dashboard-badge {
        font-size: 0.7rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }

    /* ---------- Animaciones de aparición ---------- */

    [data-animate] {
        opacity: 0;
        transform: translateY(18px);
        transition: opacity 0.5s ease-out, transform 0.5s ease-out;
    }

    [data-animate].is-visible {
        opacity: 1;
        transform: translateY(0);
    }

    [data-animate][data-delay="1"] {
        transition-delay: 0.06s;
    }

    [data-animate][data-delay="2"] {
        transition-delay: 0.12s;
    }

    [data-animate][data-delay="3"] {
        transition-delay: 0.18s;
    }

    [data-animate][data-delay="4"] {
        transition-delay: 0.24s;
    }

    /* ---------- Timeline / bitácora ---------- */

    .timeline {
        position: relative;
        padding-left: 1.5rem;
    }

    .timeline::before {
        content: "";
        position: absolute;
        left: 0.55rem;
        top: 0.3rem;
        bottom: 0.5rem;
        width: 2px;
        background: linear-gradient(to bottom, #e3e6ef, #f1f3f9);
    }

    .timeline-item {
        position: relative;
        padding-left: 1.5rem;
        margin-bottom: 1.25rem;
    }

    .timeline-icon {
        position: absolute;
        left: 0.2rem;
        top: 0.45rem;
        width: 0.9rem;
        height: 0.9rem;
        border-radius: 999px;
        border: 2px solid #ffffff;
        box-shadow: 0 0 0 3px rgba(148, 163, 184, 0.25);
    }

    .timeline-time {
        font-size: 0.75rem;
        color: #6c757d;
        margin-bottom: 0.1rem;
    }

    .timeline-title {
        font-size: 0.95rem;
        font-weight: 600;
        margin-bottom: 0.1rem;
    }

    .timeline-description {
        font-size: 0.85rem;
        color: #6c757d;
    }

    /* ---------- Car 3D card ---------- */

    .car-card {
        border-radius: 1.2rem;
        border: 1px solid #edf0f5;
        box-shadow: 0 12px 30px rgba(15, 23, 42, 0.06);
        background: radial-gradient(circle at top left, #e7f0ff 0, #ffffff 48%, #f8fafc 100%);
    }

    /* ---------- Flujo card ---------- */

    .flow-step {
        border-radius: 0.9rem;
        padding: 0.75rem 0.8rem;
        background-color: #f8fafc;
        border: 1px solid #edf0f5;
        height: 100%;
    }

    .flow-step-title {
        font-size: 0.85rem;
        font-weight: 600;
        margin-bottom: 0.2rem;
    }

    .flow-step-text {
        font-size: 0.8rem;
        color: #6c757d;
    }
</style>

<!-- HERO PRINCIPAL -->
<div class="hero-section" data-animate>
    <div class="row align-items-center">
        <div class="col-lg-7 mb-4 mb-lg-0">
            <span class="badge hero-tag rounded-pill text-bg-light text-dark border mb-3">
                PROYECTO ACADÉMICO · TÓPICOS AVANZADOS · GRUPO 08
            </span>

            <h1 class="display-5 fw-semibold mb-3">
                Control centralizado de vehículos, personas y propietarios
            </h1>

            <p class="lead text-muted mb-4">
                Un panel único para registrar vehículos, administrar la información de las personas
                y asignar propietarios de forma consistente mediante servicios API.
            </p>

            <div class="d-flex flex-wrap gap-2 mb-4">
                <a asp-controller="Vehicles" asp-action="Index" class="btn btn-primary btn-lg">
                    Ir al módulo de Vehículos
                </a>
                <a asp-controller="Owners" asp-action="Index" class="btn btn-outline-primary btn-lg">
                    Ver vehículos con propietario
                </a>
                <a asp-controller="Persons" asp-action="Index" class="btn btn-link text-decoration-none">
                    Gestionar personas
                </a>
            </div>

            <div class="row g-3">
                <div class="col-6 col-md-4">
                    <div class="small text-muted text-uppercase">Entidades</div>
                    <div class="fw-semibold">Vehículos · Personas</div>
                </div>
                <div class="col-6 col-md-4">
                    <div class="small text-muted text-uppercase">Relaciones</div>
                    <div class="fw-semibold">Asignación de propietarios</div>
                </div>
                <div class="col-12 col-md-4">
                    <div class="small text-muted text-uppercase">Integración</div>
                    <div class="fw-semibold">Consumo de API en la nube</div>
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="card card-soft h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="card-title mb-0">Qué puedes hacer aquí</h5>
                        <span class="badge rounded-pill text-bg-light dashboard-badge">Resumen</span>
                    </div>

                    <div class="d-flex flex-column gap-2">
                        <div class="d-flex">
                            <div class="me-3 text-primary fw-bold">01</div>
                            <div>
                                <div class="fw-semibold">Registrar vehículos</div>
                                <div class="small text-muted">
                                    Guarda placa, marca y modelo para cada unidad del sistema.
                                </div>
                            </div>
                        </div>
                        <div class="d-flex">
                            <div class="me-3 text-success fw-bold">02</div>
                            <div>
                                <div class="fw-semibold">Administrar personas</div>
                                <div class="small text-muted">
                                    Mantén actualizada la información básica de las personas.
                                </div>
                            </div>
                        </div>
                        <div class="d-flex">
                            <div class="me-3 text-secondary fw-bold">03</div>
                            <div>
                                <div class="fw-semibold">Asignar propietarios</div>
                                <div class="small text-muted">
                                    Relaciona cada vehículo con su propietario mediante los endpoints
                                    <code class="small">/api/Vehicles/with-owner</code> y
                                    <code class="small">/api/Vehicles/{vehicleId}/Owner/{ownerId}</code>.
                                </div>
                            </div>
                        </div>
                        <div class="border-top mt-3 pt-2 small text-muted">
                            Toda la información se obtiene y actualiza consumiendo el API remoto desde el módulo web.
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- DASHBOARD DE INDICADORES -->
<div class="row g-4 mb-5">
    <div class="col-md-3" data-animate data-delay="1">
        <div class="card card-soft card-hover h-100">
            <div class="card-body text-center">
                <div class="text-muted small mb-1">Total de vehículos</div>
                <div class="display-6 fw-semibold text-primary counter"
                     data-value="@Model.TotalVehicles">0</div>
                <div class="small text-muted mt-1">Registrados en el sistema</div>
            </div>
        </div>
    </div>

    <div class="col-md-3" data-animate data-delay="2">
        <div class="card card-soft card-hover h-100">
            <div class="card-body text-center">
                <div class="text-muted small mb-1">Total de personas</div>
                <div class="display-6 fw-semibold text-success counter"
                     data-value="@Model.TotalPersons">0</div>
                <div class="small text-muted mt-1">Disponibles como propietarios</div>
            </div>
        </div>
    </div>

    <div class="col-md-3" data-animate data-delay="3">
        <div class="card card-soft card-hover h-100">
            <div class="card-body text-center">
                <div class="text-muted small mb-1">Vehículos con propietario</div>
                <div class="display-6 fw-semibold text-secondary counter"
                     data-value="@Model.VehiclesWithOwner">0</div>
                <div class="small text-muted mt-1">Relaciones activas</div>
            </div>
        </div>
    </div>

    <div class="col-md-3" data-animate data-delay="4">
        <div class="card card-soft card-hover h-100">
            <div class="card-body text-center">
                <div class="text-muted small mb-1">Vehículos sin propietario</div>
                <div class="display-6 fw-semibold text-danger counter"
                     data-value="@Model.VehiclesWithoutOwner">0</div>
                <div class="small text-muted mt-1">Pendientes de asignación</div>
            </div>
        </div>
    </div>
</div>

<!-- VISUALIZACIÓN 3D -->
<div class="row justify-content-center my-5" data-animate>
    <div class="col-md-8 text-center">
        <h4 class="mb-3">Visualización 3D de Vehículo</h4>

        <div class="card car-card">
            <div class="card-body">
                <canvas id="carCanvas" class="w-100" style="height: 380px; display: block;"></canvas>
                <p class="text-muted small mt-2 mb-0">
                    Vehículo 3D estilizado y elegante, rotando de forma constante como representación de la flota.
                </p>
            </div>
        </div>
    </div>
</div>

<!-- TARJETAS RESUMEN DE MÓDULOS -->
<div class="row g-4 mb-4">
    <div class="col-md-4" data-animate data-delay="1">
        <div class="card card-soft card-hover h-100">
            <div class="card-body">
                <div class="small text-uppercase text-muted mb-1">Módulo</div>
                <h5 class="card-title mb-2">Vehículos</h5>
                <p class="card-text text-muted small mb-3">
                    Consulta, registro y actualización de vehículos. Es la base
                    para saber qué unidades hay en el sistema.
                </p>
                <a asp-controller="Vehicles" asp-action="Index" class="stretched-link text-decoration-none">
                    Abrir módulo de vehículos →
                </a>
            </div>
        </div>
    </div>

    <div class="col-md-4" data-animate data-delay="2">
        <div class="card card-soft card-hover h-100">
            <div class="card-body">
                <div class="small text-uppercase text-muted mb-1">Módulo</div>
                <h5 class="card-title mb-2">Personas</h5>
                <p class="card-text text-muted small mb-3">
                    Mantén la información de las personas (nombre, apellidos, correo)
                    que luego podrán ser asignadas como propietarias.
                </p>
                <a asp-controller="Persons" asp-action="Index" class="stretched-link text-decoration-none">
                    Abrir módulo de personas →
                </a>
            </div>
        </div>
    </div>

    <div class="col-md-4" data-animate data-delay="3">
        <div class="card card-soft card-hover h-100">
            <div class="card-body">
                <div class="small text-uppercase text-muted mb-1">Módulo</div>
                <h5 class="card-title mb-2">Propietarios</h5>
                <p class="card-text text-muted small mb-3">
                    Visualiza la relación vehículo–propietario y actualízala consumiendo
                    directamente los endpoints del API.
                </p>
                <a asp-controller="Owners" asp-action="Index" class="stretched-link text-decoration-none">
                    Abrir módulo de propietarios →
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Línea del tiempo / Bitácora -->
@if (Model.RecentActivity != null && Model.RecentActivity.Any())
{
    <div class="card card-soft mb-4" data-animate>
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h3 class="h5 mb-0">Actividad reciente</h3>
                <span class="badge rounded-pill text-bg-light">
                    Bitácora del sistema
                </span>
            </div>

            <div class="timeline">
                @foreach (var entry in Model.RecentActivity)
                {
                    var badgeClass = $"bg-{entry.Level}";

                    <div class="timeline-item">
                        <div class="timeline-icon @badgeClass"></div>

                        <div class="timeline-time">
                            @entry.Timestamp.ToString("dd/MM/yyyy HH:mm")
                            · <span class="badge rounded-pill text-bg-light">@entry.Category</span>
                        </div>

                        <div class="timeline-title">
                            @entry.Title
                        </div>

                        <div class="timeline-description">
                            @entry.Description
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
}

<!-- FLUJO RESUMIDO -->
<div class="card card-soft mb-4" data-animate>
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h3 class="h5 mb-0">Flujo principal de trabajo</h3>
            <span class="badge rounded-pill text-bg-light">Vista rápida</span>
        </div>

        <div class="row g-3">
            <div class="col-md-3">
                <div class="flow-step">
                    <div class="flow-step-title">1. Personas</div>
                    <div class="flow-step-text">
                        Registrar primero las personas que formarán parte del sistema.
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="flow-step">
                    <div class="flow-step-title">2. Vehículos</div>
                    <div class="flow-step-text">
                        Dar de alta los vehículos con los datos básicos requeridos.
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="flow-step">
                    <div class="flow-step-title">3. Asignación</div>
                    <div class="flow-step-text">
                        Relacionar cada vehículo con su propietario en el módulo de Propietarios.
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="flow-step">
                    <div class="flow-step-title">4. Consulta</div>
                    <div class="flow-step-text">
                        Revisar en cualquier momento el listado de vehículos con su propietario actual.
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- Three.js clásico desde CDN, sin módulos -->
    <script src="https://cdn.jsdelivr.net/npm/three@0.160.0/build/three.min.js"></script>

    <script>
        (function () {
            const canvas = document.getElementById("carCanvas");
            if (!canvas) return;

            // Renderer
            const renderer = new THREE.WebGLRenderer({
                canvas: canvas,
                antialias: true,
                alpha: true
            });

            // Escena y cámara
            const scene = new THREE.Scene();
            scene.background = new THREE.Color(0xf8f9fa); // Light mode

            const camera = new THREE.PerspectiveCamera(
                55,
                1,   // se ajusta en resize()
                0.1,
                1000
            );
            camera.position.set(5, 2.5, 7);
            camera.lookAt(0, 0.8, 0);

            // Luces
            const hemiLight = new THREE.HemisphereLight(0xffffff, 0xd0d0d0, 0.7);
            hemiLight.position.set(0, 10, 0);
            scene.add(hemiLight);

            const dirLight = new THREE.DirectionalLight(0xffffff, 0.9);
            dirLight.position.set(6, 10, 5);
            dirLight.castShadow = false;
            scene.add(dirLight);

            const ambient = new THREE.AmbientLight(0xffffff, 0.35);
            scene.add(ambient);

            // Suelo
            const groundGeometry = new THREE.PlaneGeometry(40, 40);
            const groundMaterial = new THREE.MeshStandardMaterial({
                color: 0xe9ecef,
                roughness: 0.95,
                metalness: 0
            });
            const ground = new THREE.Mesh(groundGeometry, groundMaterial);
            ground.rotation.x = -Math.PI / 2;
            ground.position.y = -0.01;
            scene.add(ground);

            // Construcción del carro
            const car = new THREE.Group();

            const bodyMaterial = new THREE.MeshStandardMaterial({
                color: 0x0b5ed7,
                metalness: 0.8,
                roughness: 0.25
            });

            const tireMaterial = new THREE.MeshStandardMaterial({
                color: 0x111111,
                metalness: 0.2,
                roughness: 0.8
            });

            const rimMaterial = new THREE.MeshStandardMaterial({
                color: 0xcfd2d4,
                metalness: 1.0,
                roughness: 0.2
            });

            const glassMaterial = new THREE.MeshStandardMaterial({
                color: 0xdbe4f0,
                transparent: true,
                opacity: 0.7,
                metalness: 0.3,
                roughness: 0.1
            });

            const frontLightMaterial = new THREE.MeshStandardMaterial({
                color: 0xfff3cd,
                emissive: 0xffe9a6,
                emissiveIntensity: 0.6
            });

            const rearLightMaterial = new THREE.MeshStandardMaterial({
                color: 0xff4b4b,
                emissive: 0xff0000,
                emissiveIntensity: 0.7
            });

            // Cuerpo principal
            const bodyGeometry = new THREE.BoxGeometry(3.6, 0.7, 1.7);
            const body = new THREE.Mesh(bodyGeometry, bodyMaterial);
            body.position.y = 0.85;
            car.add(body);

            const cabinGeometry = new THREE.BoxGeometry(2.0, 0.6, 1.5);
            const cabin = new THREE.Mesh(cabinGeometry, bodyMaterial);
            cabin.position.set(0.1, 1.25, 0);
            car.add(cabin);

            const windshieldGeometry = new THREE.BoxGeometry(0.05, 0.55, 1.3);
            const windshield = new THREE.Mesh(windshieldGeometry, glassMaterial);
            windshield.position.set(-0.7, 1.22, 0);
            windshield.rotation.y = 0.05;
            car.add(windshield);

            const sideGlassGeometry = new THREE.BoxGeometry(1.15, 0.45, 0.05);
            const leftGlass = new THREE.Mesh(sideGlassGeometry, glassMaterial);
            leftGlass.position.set(0.3, 1.28, 0.8);
            car.add(leftGlass);

            const rightGlass = leftGlass.clone();
            rightGlass.position.z = -0.8;
            car.add(rightGlass);

            const hoodGeometry = new THREE.BoxGeometry(1.1, 0.35, 1.6);
            const hood = new THREE.Mesh(hoodGeometry, bodyMaterial);
            hood.position.set(1.3, 0.95, 0);
            car.add(hood);

            const trunkGeometry = new THREE.BoxGeometry(1.0, 0.45, 1.6);
            const trunk = new THREE.Mesh(trunkGeometry, bodyMaterial);
            trunk.position.set(-1.3, 0.98, 0);
            car.add(trunk);

            const stripeGeometry = new THREE.BoxGeometry(3.4, 0.03, 0.05);
            const stripeMaterial = new THREE.MeshStandardMaterial({
                color: 0xf8f9fa,
                metalness: 0.6,
                roughness: 0.3
            });
            const stripeLeft = new THREE.Mesh(stripeGeometry, stripeMaterial);
            stripeLeft.position.set(0, 0.95, 0.86);
            car.add(stripeLeft);

            const stripeRight = stripeLeft.clone();
            stripeRight.position.z = -0.86;
            car.add(stripeRight);

            const tireGeometry = new THREE.CylinderGeometry(0.45, 0.45, 0.5, 24);
            const rimGeometry = new THREE.CylinderGeometry(0.2, 0.2, 0.52, 16);

            function createWheel(x, z) {
                const group = new THREE.Group();

                const tire = new THREE.Mesh(tireGeometry, tireMaterial);
                tire.rotation.z = Math.PI / 2;
                group.add(tire);

                const rim = new THREE.Mesh(rimGeometry, rimMaterial);
                rim.rotation.z = Math.PI / 2;
                group.add(rim);

                group.position.set(x, 0.4, z);
                return group;
            }

            const wheelFL = createWheel(1.35, 0.9);
            const wheelFR = createWheel(1.35, -0.9);
            const wheelRL = createWheel(-1.35, 0.9);
            const wheelRR = createWheel(-1.35, -0.9);
            car.add(wheelFL, wheelFR, wheelRL, wheelRR);

            const headlightGeometry = new THREE.BoxGeometry(0.12, 0.22, 0.3);
            const headlightLeft = new THREE.Mesh(headlightGeometry, frontLightMaterial);
            headlightLeft.position.set(1.9, 0.85, 0.55);
            const headlightRight = headlightLeft.clone();
            headlightRight.position.z = -0.55;
            car.add(headlightLeft, headlightRight);

            const rearLightGeometry = new THREE.BoxGeometry(0.12, 0.22, 0.35);
            const rearLightLeft = new THREE.Mesh(rearLightGeometry, rearLightMaterial);
            rearLightLeft.position.set(-1.9, 0.9, 0.6);
            const rearLightRight = rearLightLeft.clone();
            rearLightRight.position.z = -0.6;
            car.add(rearLightLeft, rearLightRight);

            car.position.y = 0.05;
            scene.add(car);

            function resizeRenderer() {
                const width = canvas.clientWidth || canvas.parentElement.clientWidth || 600;
                const height = canvas.clientHeight || 380;

                renderer.setSize(width, height, false);
                camera.aspect = width / height;
                camera.updateProjectionMatrix();
            }

            window.addEventListener("resize", resizeRenderer);
            resizeRenderer();

            function animate() {
                requestAnimationFrame(animate);

                car.rotation.y += 0.006;

                const t = Date.now() * 0.001;
                car.position.y = 0.05 + Math.sin(t) * 0.02;

                renderer.render(scene, camera);
            }

            animate();
        })();
    </script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Contadores animados
            const counters = document.querySelectorAll(".counter");

            counters.forEach(counter => {
                const target = parseInt(counter.getAttribute("data-value"));
                let current = 0;
                const increment = Math.max(1, Math.floor(target / 40));

                const interval = setInterval(() => {
                    current += increment;
                    if (current >= target) {
                        current = target;
                        clearInterval(interval);
                    }
                    counter.textContent = current;
                }, 20);
            });

            // Animaciones al hacer scroll (fade-in)
            const animatedItems = document.querySelectorAll("[data-animate]");

            const observer = new IntersectionObserver(entries => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add("is-visible");
                        observer.unobserve(entry.target);
                    }
                });
            }, {
                threshold: 0.12
            });

            animatedItems.forEach(el => observer.observe(el));
        });
    </script>
}
