@{
    ViewData["Title"] = "Sistema de Gestión de Vehículos";
}

<div class="row align-items-center mb-5">
    <div class="col-lg-7">
        <h1 class="display-5 fw-bold mb-3">
            Sistema de Gestión de Vehículos
        </h1>

        <p class="lead text-muted">
            Aplicación web para administrar vehículos, personas y propietarios
            de forma centralizada y sencilla. Desde aquí puedes registrar la
            información, mantenerla actualizada y relacionar cada vehículo con
            su dueño.
        </p>

        <div class="d-flex flex-wrap gap-2 mt-3">
            <a asp-controller="Vehicles" asp-action="Index" class="btn btn-primary btn-lg">
                Gestionar vehículos
            </a>
            <a asp-controller="Persons" asp-action="Index" class="btn btn-outline-primary btn-lg">
                Gestionar personas
            </a>
            <a asp-controller="Owners" asp-action="Index" class="btn btn-outline-secondary btn-lg">
                Propietarios de vehículos
            </a>
        </div>

        <p class="text-muted small mt-3 mb-0">
            Proyecto académico · Tópicos Avanzados de Programación · Grupo 08
        </p>
    </div>

    <div class="col-lg-5 mt-4 mt-lg-0">
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <h5 class="card-title mb-3">Resumen del sistema</h5>
                <ul class="list-unstyled mb-0">
                    <li class="mb-2">
                        <span class="badge bg-primary text-light me-2">Vehículos</span>
                        Registro de placa, marca, modelo y detalles del vehículo.
                    </li>
                    <li class="mb-2">
                        <span class="badge bg-success text-light me-2">Personas</span>
                        Administración de la información básica de las personas.
                    </li>
                    <li class="mb-2">
                        <span class="badge bg-secondary text-light me-2">Propietarios</span>
                        Asignación de un propietario a cada vehículo mediante la API.
                    </li>
                    <li class="mb-2">
                        <span class="badge bg-info text-dark me-2">API</span>
                        Integración con servicios en la nube para lectura y actualización de datos.
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-md-4">
        <div class="card h-100 border-0 shadow-sm">
            <div class="card-body">
                <h5 class="card-title">Módulo de Vehículos</h5>
                <p class="card-text text-muted">
                    Permite consultar, crear y actualizar la información de los vehículos
                    registrados. Es el punto central para conocer el estado de la flota.
                </p>
                <a asp-controller="Vehicles" asp-action="Index" class="stretched-link text-decoration-none">
                    Ir al módulo →
                </a>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card h-100 border-0 shadow-sm">
            <div class="card-body">
                <h5 class="card-title">Módulo de Personas</h5>
                <p class="card-text text-muted">
                    Aquí se administra la información de contacto de las personas:
                    nombre, apellidos y correo electrónico, utilizada luego para los propietarios.
                </p>
                <a asp-controller="Persons" asp-action="Index" class="stretched-link text-decoration-none">
                    Ir al módulo →
                </a>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card h-100 border-0 shadow-sm">
            <div class="card-body">
                <h5 class="card-title">Asignación de Propietarios</h5>
                <p class="card-text text-muted">
                    Relaciona cada vehículo con su propietario utilizando los servicios
                    de la API. Facilita saber quién es responsable de cada vehículo.
                </p>
                <a asp-controller="Owners" asp-action="Index" class="stretched-link text-decoration-none">
                    Ir al módulo →
                </a>
            </div>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <h3 class="h5 mb-3">Flujo principal de trabajo</h3>
        <ol class="mb-0 text-muted">
            <li class="mb-1">Registrar las personas que formarán parte del sistema.</li>
            <li class="mb-1">Registrar los vehículos con su respectiva información básica.</li>
            <li class="mb-1">Asignar un propietario a cada vehículo desde el módulo de Propietarios.</li>
            <li class="mb-1">Consultar en cualquier momento el listado de vehículos con su propietario actual.</li>
        </ol>
    </div>
</div>

<div class="row justify-content-center my-5">
    <div class="col-md-6 text-center">
        <h4 class="mb-3">Visualización 3D de Vehículo</h4>

        <div class="card shadow-sm border-0">
            <div class="card-body">
                <canvas id="threeCanvas" style="width:100%; height:320px; display:block;"></canvas>
                <p class="text-muted small mt-2 mb-0">
                    Vehículo 3D rotando, representando la gestión de la flota.
                </p>
            </div>
        </div>
    </div>
</div>


@section Scripts {

<script src="https://cdn.jsdelivr.net/npm/three@0.160.0/build/three.min.js"></script>

<script>
    const canvas = document.getElementById("threeCanvas");

    if (canvas) {
        // Escena
        const scene = new THREE.Scene();
        scene.background = new THREE.Color(0xf8f9fa); // light mode

        // Cámara
        const camera = new THREE.PerspectiveCamera(
            60,
            canvas.clientWidth / canvas.clientHeight,
            0.1,
            1000
        );
        camera.position.set(4, 3, 6);
        camera.lookAt(0, 0, 0);

        // Renderer
        const renderer = new THREE.WebGLRenderer({
            canvas: canvas,
            antialias: true
        });
        renderer.setSize(canvas.clientWidth, canvas.clientHeight);
        renderer.setPixelRatio(window.devicePixelRatio);

        // --- Vehículo low-poly ---

        const car = new THREE.Group();

        // Cuerpo principal
        const bodyGeometry = new THREE.BoxGeometry(3.2, 0.8, 1.6);
        const bodyMaterial = new THREE.MeshStandardMaterial({
            color: 0x0d6efd, // azul tipo Bootstrap
            metalness: 0.4,
            roughness: 0.5
        });
        const body = new THREE.Mesh(bodyGeometry, bodyMaterial);
        body.position.y = 0.7;
        car.add(body);

        // Cabina
        const cabinGeometry = new THREE.BoxGeometry(1.6, 0.7, 1.4);
        const cabinMaterial = new THREE.MeshStandardMaterial({
            color: 0xffffff,
            metalness: 0.1,
            roughness: 0.2
        });
        const cabin = new THREE.Mesh(cabinGeometry, cabinMaterial);
        cabin.position.set(0.2, 1.2, 0);
        car.add(cabin);

        // Parabrisas (simplemente un bloque "vidrio")
        const glassGeometry = new THREE.BoxGeometry(0.05, 0.6, 1.2);
        const glassMaterial = new THREE.MeshStandardMaterial({
            color: 0xced4da,
            transparent: true,
            opacity: 0.8
        });
        const windshield = new THREE.Mesh(glassGeometry, glassMaterial);
        windshield.position.set(-0.6, 1.1, 0);
        car.add(windshield);

        // Ruedas
        const wheelGeometry = new THREE.CylinderGeometry(0.35, 0.35, 0.4, 24);
        const wheelMaterial = new THREE.MeshStandardMaterial({
            color: 0x212529,
            metalness: 0.3,
            roughness: 0.7
        });

        function createWheel(x, z) {
            const wheel = new THREE.Mesh(wheelGeometry, wheelMaterial);
            wheel.rotation.z = Math.PI / 2;
            wheel.position.set(x, 0.35, z);
            return wheel;
        }

        const wheelFL = createWheel(1.2, 0.8);   // front-left
        const wheelFR = createWheel(1.2, -0.8);  // front-right
        const wheelRL = createWheel(-1.2, 0.8);  // rear-left
        const wheelRR = createWheel(-1.2, -0.8); // rear-right

        car.add(wheelFL, wheelFR, wheelRL, wheelRR);

        // Luces frontales
        const lightGeom = new THREE.BoxGeometry(0.15, 0.2, 0.3);
        const lightMat = new THREE.MeshStandardMaterial({ color: 0xfff3cd });

        const frontLightL = new THREE.Mesh(lightGeom, lightMat);
        frontLightL.position.set(1.7, 0.8, 0.5);
        const frontLightR = new THREE.Mesh(lightGeom, lightMat);
        frontLightR.position.set(1.7, 0.8, -0.5);

        car.add(frontLightL, frontLightR);

        // Posición inicial del carro
        car.position.y = 0.1;
        scene.add(car);

        // Suelo
        const planeGeometry = new THREE.PlaneGeometry(20, 20);
        const planeMaterial = new THREE.MeshStandardMaterial({
            color: 0xe9ecef,
            roughness: 0.9,
            metalness: 0
        });
        const plane = new THREE.Mesh(planeGeometry, planeMaterial);
        plane.rotation.x = -Math.PI / 2;
        scene.add(plane);

        // Luces
        const keyLight = new THREE.DirectionalLight(0xffffff, 0.9);
        keyLight.position.set(5, 8, 5);
        scene.add(keyLight);

        const fillLight = new THREE.DirectionalLight(0xffffff, 0.4);
        fillLight.position.set(-5, 4, -3);
        scene.add(fillLight);

        const ambient = new THREE.AmbientLight(0xffffff, 0.5);
        scene.add(ambient);

        // Animación: rotación vertical constante
        function animate() {
            requestAnimationFrame(animate);

            car.rotation.y += 0.01; // rotación vertical
            renderer.render(scene, camera);
        }

        animate();

        // Responsive
        window.addEventListener("resize", () => {
            const width = canvas.clientWidth;
            const height = canvas.clientHeight || 320;

            camera.aspect = width / height;
            camera.updateProjectionMatrix();
            renderer.setSize(width, height);
        });
    }
</script>

}
