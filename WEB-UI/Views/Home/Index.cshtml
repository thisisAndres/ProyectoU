@{
    ViewData["Title"] = "Sistema de Gestión de Vehículos";
}

<div class="row align-items-center mb-5">
    <div class="col-lg-7">
        <h1 class="display-5 fw-bold mb-3">
            Sistema de Gestión de Vehículos
        </h1>

        <p class="lead text-muted">
            Aplicación web para administrar vehículos, personas y propietarios
            de forma centralizada y sencilla. Desde aquí puedes registrar la
            información, mantenerla actualizada y relacionar cada vehículo con
            su dueño.
        </p>

        <div class="d-flex flex-wrap gap-2 mt-3">
            <a asp-controller="Vehicles" asp-action="Index" class="btn btn-primary btn-lg">
                Gestionar vehículos
            </a>
            <a asp-controller="Persons" asp-action="Index" class="btn btn-outline-primary btn-lg">
                Gestionar personas
            </a>
            <a asp-controller="Owners" asp-action="Index" class="btn btn-outline-secondary btn-lg">
                Propietarios de vehículos
            </a>
        </div>

        <p class="text-muted small mt-3 mb-0">
            Proyecto académico · Tópicos Avanzados de Programación · Grupo 08
        </p>
    </div>

    <div class="col-lg-5 mt-4 mt-lg-0">
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <h5 class="card-title mb-3">Resumen del sistema</h5>
                <ul class="list-unstyled mb-0">
                    <li class="mb-2">
                        <span class="badge bg-primary text-light me-2">Vehículos</span>
                        Registro de placa, marca, modelo y detalles del vehículo.
                    </li>
                    <li class="mb-2">
                        <span class="badge bg-success text-light me-2">Personas</span>
                        Administración de la información básica de las personas.
                    </li>
                    <li class="mb-2">
                        <span class="badge bg-secondary text-light me-2">Propietarios</span>
                        Asignación de un propietario a cada vehículo mediante la API.
                    </li>
                    <li class="mb-2">
                        <span class="badge bg-info text-dark me-2">API</span>
                        Integración con servicios en la nube para lectura y actualización de datos.
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-md-4">
        <div class="card h-100 border-0 shadow-sm">
            <div class="card-body">
                <h5 class="card-title">Módulo de Vehículos</h5>
                <p class="card-text text-muted">
                    Permite consultar, crear y actualizar la información de los vehículos
                    registrados. Es el punto central para conocer el estado de la flota.
                </p>
                <a asp-controller="Vehicles" asp-action="Index" class="stretched-link text-decoration-none">
                    Ir al módulo →
                </a>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card h-100 border-0 shadow-sm">
            <div class="card-body">
                <h5 class="card-title">Módulo de Personas</h5>
                <p class="card-text text-muted">
                    Aquí se administra la información de contacto de las personas:
                    nombre, apellidos y correo electrónico, utilizada luego para los propietarios.
                </p>
                <a asp-controller="Persons" asp-action="Index" class="stretched-link text-decoration-none">
                    Ir al módulo →
                </a>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card h-100 border-0 shadow-sm">
            <div class="card-body">
                <h5 class="card-title">Asignación de Propietarios</h5>
                <p class="card-text text-muted">
                    Relaciona cada vehículo con su propietario utilizando los servicios
                    de la API. Facilita saber quién es responsable de cada vehículo.
                </p>
                <a asp-controller="Owners" asp-action="Index" class="stretched-link text-decoration-none">
                    Ir al módulo →
                </a>
            </div>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <h3 class="h5 mb-3">Flujo principal de trabajo</h3>
        <ol class="mb-0 text-muted">
            <li class="mb-1">Registrar las personas que formarán parte del sistema.</li>
            <li class="mb-1">Registrar los vehículos con su respectiva información básica.</li>
            <li class="mb-1">Asignar un propietario a cada vehículo desde el módulo de Propietarios.</li>
            <li class="mb-1">Consultar en cualquier momento el listado de vehículos con su propietario actual.</li>
        </ol>
    </div>
</div>

<div class="row justify-content-center my-5">
    <div class="col-md-8 text-center">
        <h4 class="mb-3">Visualización 3D de Vehículo</h4>

        <div class="card shadow-sm border-0">
            <div class="card-body">
                <canvas id="carCanvas" class="w-100" style="height: 380px; display: block;"></canvas>
                <p class="text-muted small mt-2 mb-0">
                    Modelo 3D realista rotando constantemente, representando la gestión de vehículos.
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/three@0.160.0/build/three.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/three@0.160.0/examples/js/loaders/GLTFLoader.js"></script>

    <script>
        (function () {
            const canvas = document.getElementById("carCanvas");
            if (!canvas) return;

            // URL pública del modelo GLB (puedes cambiarla por tu propio modelo)
            const MODEL_URL = "https://github.com/KhronosGroup/glTF-Sample-Models/raw/master/2.0/Buggy/glTF-Binary/Buggy.glb";

            const renderer = new THREE.WebGLRenderer({
                canvas: canvas,
                antialias: true,
                alpha: true
            });

            const scene = new THREE.Scene();
            scene.background = new THREE.Color(0xf8f9fa); // light mode

            // Cámara
            const camera = new THREE.PerspectiveCamera(
                55,
                1, // se ajusta después
                0.1,
                1000
            );
            camera.position.set(5, 2.5, 6);

            // Luces
            const keyLight = new THREE.DirectionalLight(0xffffff, 1.0);
            keyLight.position.set(5, 10, 7);
            scene.add(keyLight);

            const fillLight = new THREE.DirectionalLight(0xffffff, 0.4);
            fillLight.position.set(-6, 4, -4);
            scene.add(fillLight);

            const ambient = new THREE.AmbientLight(0xffffff, 0.5);
            scene.add(ambient);

            // Suelo suave para que el carro no "flote"
            const groundGeo = new THREE.PlaneGeometry(30, 30);
            const groundMat = new THREE.MeshStandardMaterial({
                color: 0xe9ecef,
                roughness: 0.9,
                metalness: 0
            });
            const ground = new THREE.Mesh(groundGeo, groundMat);
            ground.rotation.x = -Math.PI / 2;
            ground.position.y = -0.01;
            scene.add(ground);

            let car = null;

            const loader = new THREE.GLTFLoader();
            loader.load(
                MODEL_URL,
                function (gltf) {
                    car = gltf.scene;

                    // Normalizar tamaño y posición
                    car.scale.set(0.6, 0.6, 0.6);
                    car.position.set(0, 0, 0);

                    // Centrar en origen (opcional pero ayuda a que la rotación se vea bien)
                    const box = new THREE.Box3().setFromObject(car);
                    const center = box.getCenter(new THREE.Vector3());
                    car.position.sub(center.set(center.x, 0, center.z));

                    scene.add(car);
                },
                undefined,
                function (error) {
                    console.error("Error cargando modelo 3D:", error);
                }
            );

            // Función para ajustar tamaño al canvas / responsive
            function resizeRenderer() {
                const width = canvas.clientWidth || canvas.parentElement.clientWidth || 600;
                const height = canvas.clientHeight || 380;

                renderer.setSize(width, height, false);
                camera.aspect = width / height;
                camera.updateProjectionMatrix();
            }

            window.addEventListener("resize", resizeRenderer);
            resizeRenderer();

            // Animación: rotación vertical constante
            function animate() {
                requestAnimationFrame(animate);

                if (car) {
                    car.rotation.y += 0.01; // giro constante
                }

                renderer.render(scene, camera);
            }

            animate();
        })();
    </script>
}
