@model IEnumerable<WEB_UI.Models.VehicleViewModel>

@{
    ViewData["Title"] = "Vehículos";
}

<h1>Vehículos</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Agregar vehículo</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Id</th>
            <th>Placa</th>
            <th>Marca</th>
            <th>Modelo</th>
            <th>OwnerId</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.Plate</td>
                <td>@item.Brand</td>
                <td>@item.Model</td>
                <td>@item.OwnerId</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">
                        Editar
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
